# Optional. Export these in your shell; this app does not automatically load .env.
BROKERASSIST_MODE=offline
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# BROKERASSIST_WEBHOOK_SECRET=replace-with-a-random-secret
# BROKERASSIST_DB=runtime/brokerassist.db
# Read-only Zendesk synthetic sandbox import, opt-in:
# ALLOW_ZENDESK_SANDBOX=yes
# ZENDESK_SUBDOMAIN=
# ZENDESK_CLIENT_ID=
# ZENDESK_CLIENT_SECRET=
# ZENDESK_ACCESS_TOKEN= (optional short-lived read-only access token)
# Restricted synthetic hosted demo (TLS supplied by the host):
# BROKERASSIST_HOSTED=yes
# BROKERASSIST_DEMO_USER=reviewer
# BROKERASSIST_DEMO_PASSWORD=
# BROKERASSIST_PUBLIC_ORIGIN=https://YOUR-HOST
